---
const horario = [
    { dias: "Lun-Vie", horas: "12:00 - 23:00" },
    { dias: "Sáb-Dom", horas: "11:00 - 00:00" }
];

const contactos = [
    { "first@guysburger.shop": "Gerente de Tienda" },
    { "second@guysburger.shop": "Jefe de Cocina" },
    { "minion1@guysburger.shop": "Soporte Técnico" },
    { "minion2@guysburger.shop": "Marketing" },
    { "minion3@guysburger.shop": "Atención al Cliente" }
];
---

<footer id="footer" class="bg-brand-black text-brand-cream relative overflow-hidden px-[5vw] pt-16 pb-8">
    <span
        class="font-bebas pointer-events-none absolute right-[-40px] bottom-[-60px] text-[22rem] leading-none select-none"
        style="color: rgba(255,214,0,0.04)"
    >
        TGB
    </span>

    <div class="relative flex flex-wrap justify-between gap-10">
        <div>
            <h4 class="font-bebas text-brand-red text-7xl leading-none" style="text-shadow: 3px 3px 0 #FFD600">
                TwoGuys<br />Burger
            </h4>
        </div>

        <div>
            <h4 class="font-marker text-brand-yellow mb-3 tracking-[4px]" style="text-shadow: 2px 2px 0 #E8192C">
                Horario
            </h4>
            {
                horario.map((h) => (
                    <p class="font-vt text-xl text-gray-400">
                        {h.dias}: {h.horas}
                    </p>
                ))
            }
        </div>

        <div>
            <h4 class="font-marker text-brand-yellow mb-3 tracking-[4px]" style="text-shadow: 2px 2px 0 #E8192C">
                Encuéntranos
            </h4>
            <p class="font-vt text-xl text-gray-400">Av. Burger 2010, Local 2</p>
            <p class="font-vt text-xl text-gray-400">Tel: (555) TWO-GUYS</p>
            <a href="#" class="font-vt hover:text-brand-yellow text-xl text-gray-400 transition-colors">
                @twoguys.burger
            </a>
            <br />
            <a
                href="/tyc"
                class="hover:text-brand-yellow font-vt mt-2 inline-block text-xl text-gray-400 transition-colors"
            >
                Términos y Condiciones
            </a>
        </div>

        <div class="flex flex-col space-y-2">
            <h4 class="font-marker text-brand-yellow mb-3 tracking-[4px]" style="text-shadow: 2px 2px 0 #E8192C">
                Contacto
            </h4>
            <ul class="font-vt space-y-1">
                {
                    contactos.map((c) => (
                        <li>
                            {Object.entries(c).map(([email, puesto]) => (
                                <a
                                    href={`mailto:${email}`}
                                    class="hover:text-brand-yellow font-vt inline-block text-xl text-gray-400 transition-colors"
                                >
                                    {email} <span class="text-brand-gray italic">({puesto})</span>
                                </a>
                            ))}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div class="relative mt-12 flex flex-wrap justify-between gap-3 border-t-2 border-gray-800 pt-5">
        <p class="font-vt text-xl text-gray-600">
            © 2010-{new Date().getFullYear()} TwoGuysBurger. Todos los derechos, igual que las salsas, reservados.
        </p>
    </div>
</footer>
