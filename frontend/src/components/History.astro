---
const facts = [
    { number: "2010", label: "Fundación" },
    { number: "100%", label: "Carne Real" },
    { number: "4", label: "Franquicias" },
    { number: "+15", label: "Años de sabor" },
    { number: "5", label: "Burgers Guys" }
];
---

<section class="bg-brand-yellow border-brand-black overflow-hidden border-y-[5px] px-[5vw] py-14 text-center">
    <p class="font-marker text-brand-red mb-2 tracking-[6px] uppercase">★ Las leyendas</p>
    <h2
        class="font-bebas text-brand-black mb-14 leading-none"
        style="font-size: clamp(3rem,7vw,5.5rem); text-shadow: 4px 4px 0 #00B4B4"
    >
        Nuestra Trayectoria
    </h2>

    <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-12 md:flex-row md:items-center">
        <div class="order-2 flex w-full justify-center md:order-1 md:w-1/4">
            <div class="relative inline-block rotate-[-8deg] transition-transform duration-300 hover:rotate-0">
                <img
                    src="/landing/twoguysdown.webp"
                    alt="Two Guys looking down"
                    class="border-brand-black aspect-3/4 h-[350px] w-auto rounded-2xl border-4 bg-white object-cover shadow-[12px_12px_0_#000]"
                />
            </div>
        </div>

        <div class="order-1 flex w-full flex-wrap content-center justify-center gap-x-12 gap-y-10 md:order-2 md:w-2/4">
            {
                facts.map((f) => (
                    <div class="flex min-w-[140px] flex-col items-center">
                        <div class="font-bebas text-brand-black text-6xl" style="text-shadow: 3px 3px 0 #E8192C">
                            {f.number}
                        </div>
                        <p class="font-vt text-brand-black text-2xl tracking-widest uppercase">{f.label}</p>
                    </div>
                ))
            }
        </div>

        <div class="order-3 flex w-full justify-center md:order-3 md:w-1/4">
            <div class="relative inline-block rotate-3 transition-transform duration-300 hover:rotate-0">
                <img
                    src="/landing/twoguysup.webp"
                    alt="Two Guys looking up"
                    class="border-brand-black aspect-3/4 h-[420px] w-auto rounded-2xl border-4 bg-white object-cover shadow-[12px_12px_0_#000]"
                />
            </div>
        </div>
    </div>
</section>
