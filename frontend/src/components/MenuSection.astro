---
// src/components/MenuSection.astro
import BurgerCard from './BurgerCard.astro'
import { burgers } from '../data/burgers'
---

<!-- Divider -->
<div class="h-4" style="background: repeating-linear-gradient(45deg, #E8192C 0px, #E8192C 12px, #FFD600 12px, #FFD600 24px)"></div>

<section id="menu" class="py-20 px-[5vw] bg-brand-cream">
  <p class="font-marker text-brand-teal tracking-[6px] uppercase mb-2"
     style="text-shadow: 2px 2px 0 #0A0A0A">
    ★ Lo que hacemos mejor
  </p>
  <h2 class="font-bebas text-brand-black leading-none mb-10"
      style="font-size: clamp(3rem,7vw,5.5rem); text-shadow: 4px 4px 0 #E8192C">
    El Menú
  </h2>
  <div class="grid gap-7" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))">
    {burgers.map(burger => <BurgerCard {...burger} />)}
  </div>
</section>