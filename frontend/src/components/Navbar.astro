---
import UserDropdown from "./UserDropdown.astro";
import { Cart } from "./Cart";

const { user, isAdmin, token } = Astro.locals;
const customerName = user?.user_metadata?.full_name || user?.email || "Cliente Web";

const links = [
    { label: "Menú", href: "/menu" },
    { label: "Nosotros", href: "/#nosotros" },
    { label: "Contacto", href: "#footer" }
];
---

<nav
    class="bg-brand-black border-brand-yellow fixed top-0 right-0 left-0 z-50 flex items-center justify-between border-b-4 px-[5vw] py-3"
>
    <a href="/" class="font-bebas text-brand-red text-5xl" style="text-shadow: 2px 2px 0 #FFD600">Two Guys Burger</a>
    <ul class="flex list-none items-center gap-7">
        {
            links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="font-bebas text-brand-cream hover:text-brand-yellow text-xl tracking-widest transition-colors"
                    >
                        {link.label}
                    </a>
                </li>
            ))
        }
        <li>
            <Cart client:load token={token} customerName={customerName} />
        </li>
        {
            user ? (
                <li>
                    <UserDropdown user={user} isAdmin={isAdmin} />
                </li>
            ) : (
                <li>
                    <a
                        href="/api/auth/signin"
                        class="font-bebas bg-brand-yellow text-brand-black inline-block cursor-pointer rounded border-none px-4 py-1 text-lg uppercase transition-colors hover:bg-yellow-500"
                    >
                        Entrar
                    </a>
                </li>
            )
        }
    </ul>
</nav>
