---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "@/components/MusicPlayer.astro";
import Navbar from "@/components/Navbar.astro";

interface Props {
    title?: string;
}
const { title = "TwoGuysBurger" } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/webp" href="/favicon.webp" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Permanent+Marker&family=VT323&display=swap"
            rel="stylesheet"
        />
        <ClientRouter />
    </head>
    <body class="bg-brand-cream overflow-x-hidden">
        <Navbar />

        <slot />

        <MusicPlayer transition:persist="music-player" />
    </body>
</html>
