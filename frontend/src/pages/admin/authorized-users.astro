---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/AdminSidebar.astro";
import { ShieldCheck } from "lucide-react";
import { AdminActions } from "@/components/AdminActions";

const {
    data: { session }
} = await Astro.locals.supabase.auth.getSession();
const token = session?.access_token || "";
---

<AdminLayout title="Two Guys Burger - Usuarios Autorizados">
    <div class="bg-brand-black flex min-h-screen pt-20">
        <AdminSidebar />

        <main class="flex-1 p-4 lg:ml-72 lg:p-8">
            <header class="mb-10 flex flex-col items-start gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="font-marker text-brand-red mb-2 text-xl tracking-widest uppercase">★ Sistema</p>
                    <h1
                        class="font-bebas text-brand-cream text-6xl leading-none"
                        style="text-shadow: 4px 4px 0 #0a0a0a, 6px 6px 0 #ffd600"
                    >
                        Usuarios Autorizados
                    </h1>
                </div>
                <div
                    class="font-vt text-brand-yellow bg-brand-black border-brand-yellow flex items-center gap-2 border-2 px-4 py-1 text-2xl"
                >
                    <ShieldCheck className="h-6 w-6" />
                    SEGURIDAD DE ACCESO
                </div>
            </header>

            <div class="mt-12 flex justify-center">
                <AdminActions client:load token={token} />
            </div>

            <div class="mx-auto mt-16 max-w-3xl">
                <div class="border-brand-red bg-brand-red/5 border-l-4 py-4 pl-6">
                    <h4 class="font-bebas text-brand-red mb-2 text-2xl tracking-wider">REGLAS DE SEGURIDAD</h4>
                    <ul class="font-vt text-brand-cream/70 list-inside list-disc space-y-2 text-lg">
                        <li>
                            Los usuarios deben iniciar sesión con la cuenta de Google institucional exacta que se
                            autorice aquí.
                        </li>
                        <li>
                            Añadir un usuario le otorga acceso total al Panel de Control (Inventario, Pedidos y
                            Sistema).
                        </li>
                        <li>Al remover un usuario, sus permisos se revocan inmediatamente.</li>
                    </ul>
                </div>
            </div>
        </main>
    </div>
</AdminLayout>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #ffd600;
        border-radius: 10px;
    }
</style>
