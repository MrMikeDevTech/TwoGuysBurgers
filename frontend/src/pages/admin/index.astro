---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/AdminSidebar.astro";
import { ShoppingCart, Users, UtensilsCrossed, ChefHat, Layers, TrendingUp, AlertTriangle } from "lucide-react";
import { getOrders } from "@/services/Orders";
import { getIngredients } from "@/services/Ingredients";
import { getRecipes } from "@/services/Recipes";
import { getCombos } from "@/services/Combos";
import { getAdmins } from "@/services/Auth";

const { token } = Astro.locals;

if (!token) {
    return Astro.redirect("/");
}

const [orders, ingredients, recipes, combos, admins] = await Promise.all([
    getOrders(token),
    getIngredients(token),
    getRecipes(token),
    getCombos(token),
    getAdmins(token)
]);

const totalSales = orders.reduce((acc, order) => acc + order.total_price, 0);
const lowStockIngredients = ingredients.filter((i) => i.stock < 10);
const recentOrders = [...orders].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 5);

const stats = [
    { label: "Ventas Totales", value: `$${totalSales.toFixed(2)}`, color: "brand-teal", icon: TrendingUp },
    { label: "Órdenes", value: orders.length.toString(), color: "brand-red", icon: ShoppingCart },
    { label: "Stock Bajo", value: lowStockIngredients.length.toString(), color: "brand-yellow", icon: AlertTriangle },
    { label: "Administradores", value: admins.length.toString(), color: "brand-cream", icon: Users }
];

const inventoryStats = [
    { label: "Ingredientes", value: ingredients.length, icon: UtensilsCrossed, color: "text-brand-yellow" },
    { label: "Recetas", value: recipes.length, icon: ChefHat, color: "text-brand-teal" },
    { label: "Combos", value: combos.length, icon: Layers, color: "text-brand-red" }
];
---

<AdminLayout title="Two Guys Burger - Dashboard">
    <div class="bg-brand-black flex h-screen">
        <AdminSidebar active="dashboard" />

        <main class="custom-scrollbar flex-1 overflow-y-auto p-8 pt-32 lg:pl-80">
            <header class="mb-12">
                <p class="font-marker text-brand-red mb-2 text-xl tracking-widest uppercase">★ Control Central</p>
                <h1
                    class="font-bebas text-brand-cream text-7xl leading-none"
                    style="text-shadow: 4px 4px 0 #0a0a0a, 6px 6px 0 #ffd600"
                >
                    ESTADO DEL NEGOCIO
                </h1>
            </header>

            <div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
                {
                    stats.map((stat) => (
                        <div
                            class={`bg-brand-black border-4 border-${stat.color} group relative overflow-hidden p-6 shadow-[8px_8px_0_#000] transition-transform hover:-translate-y-1`}
                        >
                            <div class="relative z-10">
                                <p class={`font-vt text-${stat.color} mb-1 text-xl tracking-widest uppercase`}>
                                    {stat.label}
                                </p>
                                <h3 class="font-bebas text-brand-cream text-5xl">{stat.value}</h3>
                            </div>
                            <stat.icon
                                className={`absolute -right-4 -bottom-4 h-28 w-28 opacity-10 text-${stat.color} transition-transform group-hover:scale-110`}
                            />
                        </div>
                    ))
                }
            </div>

            <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
                <div class="bg-brand-black border-brand-yellow border-4 p-8 shadow-[12px_12px_0_#000] lg:col-span-2">
                    <h2
                        class="font-bebas text-brand-yellow border-brand-yellow mb-8 flex items-center gap-3 border-b-4 pb-4 text-4xl"
                    >
                        <ShoppingCart className="text-brand-red" /> PEDIDOS RECIENTES
                    </h2>
                    <div class="space-y-4">
                        {
                            recentOrders.length === 0 ? (
                                <p class="font-vt text-brand-cream/50 py-10 text-center text-2xl">
                                    No hay pedidos registrados
                                </p>
                            ) : (
                                recentOrders.map((order) => (
                                    <div class="border-brand-cream/20 hover:border-brand-teal flex items-center justify-between border-2 bg-white/5 p-4 transition-all">
                                        <div class="flex flex-col">
                                            <span class="font-bebas text-brand-cream text-2xl">
                                                #{order.id.substring(order.id.length - 6).toUpperCase()} -{" "}
                                                {order.customer_name}
                                            </span>
                                            <span class="font-vt text-brand-teal text-lg">
                                                {new Date(order.date).toLocaleString()}
                                            </span>
                                        </div>
                                        <div class="flex flex-col items-end">
                                            <span class="font-bebas text-brand-yellow text-3xl">
                                                ${order.total_price.toFixed(2)}
                                            </span>
                                            <span
                                                class={`font-vt text-sm uppercase ${order.status === "done" ? "text-green-500" : "text-brand-red"}`}
                                            >
                                                {order.status}
                                            </span>
                                        </div>
                                    </div>
                                ))
                            )
                        }
                    </div>
                    <div class="mt-8 text-right">
                        <a
                            href="/admin/orders"
                            class="font-bebas text-brand-teal hover:text-brand-yellow text-2xl underline decoration-2 underline-offset-4"
                        >
                            VER TODAS LAS ÓRDENES →</a
                        >
                    </div>
                </div>

                <div class="flex flex-col gap-8">
                    <div class="bg-brand-black border-brand-red border-4 p-8 shadow-[12px_12px_0_#000]">
                        <h2
                            class="font-bebas text-brand-red border-brand-red mb-6 border-b-4 pb-4 text-center text-4xl"
                        >
                            RESUMEN CATÁLOGO
                        </h2>
                        <div class="grid grid-cols-1 gap-6">
                            {
                                inventoryStats.map((item) => (
                                    <div class="border-brand-cream/10 flex items-center gap-4 border-2 bg-white/5 p-4">
                                        <item.icon className={`${item.color} h-10 w-10`} />
                                        <div class="flex flex-col">
                                            <span class="font-vt text-brand-cream text-lg tracking-widest uppercase">
                                                {item.label}
                                            </span>
                                            <span class="font-bebas text-brand-cream text-3xl leading-none">
                                                {item.value} REGISTRADOS
                                            </span>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <div class="bg-brand-black border-brand-teal border-4 p-8 shadow-[12px_12px_0_#000]">
                        <h2 class="font-bebas text-brand-teal border-brand-teal mb-6 border-b-4 pb-4 text-3xl">
                            ALERTAS DE STOCK
                        </h2>
                        <div class="font-vt space-y-4">
                            {
                                lowStockIngredients.length === 0 ? (
                                    <p class="text-xl text-green-500">Inventario saludable ★</p>
                                ) : (
                                    lowStockIngredients.slice(0, 4).map((ing) => (
                                        <div class="border-brand-yellow/30 bg-brand-yellow/5 border-l-4 py-2 pl-4">
                                            <p class="text-brand-cream text-xl uppercase">{ing.name}</p>
                                            <p class="text-brand-red text-lg">
                                                SOLO QUEDAN {ing.stock} {ing.unit.toUpperCase()}
                                            </p>
                                        </div>
                                    ))
                                )
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</AdminLayout>

<style is:global>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #ffd600;
        border-radius: 10px;
    }
</style>
