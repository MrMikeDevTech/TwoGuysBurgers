---
import Layout from "@/layouts/Layout.astro";
import { Check, ArrowLeft, Ticket as TicketIcon } from "lucide-react";
---

<Layout title="Two Guys Burger - ¡Pedido Realizado!">
    <main class="bg-brand-yellow flex min-h-screen flex-col items-center px-4 pt-32 pb-20">
        <div
            class="border-brand-black mb-8 animate-bounce rounded-full border-4 bg-green-500 p-4 shadow-[6px_6px_0_#000]"
        >
            <Check size={80} strokeWidth={4} className="text-white" />
        </div>

        <h1
            class="font-bebas text-brand-black mb-12 text-center text-6xl md:text-8xl"
            style="text-shadow: 4px 4px 0 #E8192C"
        >
            ¡PEDIDO EN CAMINO!
        </h1>

        <div class="border-brand-black relative w-full max-w-md border-4 bg-white p-8 shadow-[12px_12px_0_#000]">
            <div class="absolute -top-3 right-0 left-0 flex h-3 justify-around overflow-hidden">
                {
                    Array.from({ length: 20 }).map((_, i) => (
                        <div key={i} class="bg-brand-yellow border-brand-black h-4 w-4 -translate-y-2 rotate-45 border-2" />
                    ))
                }
            </div>

            <div id="receipt-content" class="hidden">
                <div class="mb-8 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <TicketIcon className="text-brand-black" />
                        <span class="font-bebas text-2xl">TICKET #<span id="order-id"></span></span>
                    </div>
                    <span class="font-vt text-lg" id="order-date"></span>
                </div>

                <div class="border-brand-black my-6 space-y-4 border-y-2 border-dashed py-6">
                    <div class="font-vt flex justify-between text-xl">
                        <span>ESTADO:</span>
                        <span class="font-bold text-green-600">CONFIRMADO</span>
                    </div>
                    <div class="font-vt flex justify-between text-xl">
                        <span>CLIENTE:</span>
                        <span id="customer-name"></span>
                    </div>
                    
                    <div class="border-brand-black border-t-2 border-dashed pt-4">
                        <p class="font-bebas mb-2 text-xl">PRODUCTOS:</p>
                        <ul id="product-list" class="font-vt space-y-2 text-lg">
                        </ul>
                    </div>

                    <div class="border-brand-black border-t-2 border-dashed pt-4 flex justify-between items-end">
                        <span class="font-bebas text-2xl">TOTAL:</span>
                        <span class="font-bebas text-brand-red text-4xl" id="order-total"></span>
                    </div>
                </div>

                <div class="font-vt mt-8 text-center text-lg opacity-60">
                    <p>GRACIAS POR TU COMPRA</p>
                    <p>¡VUELVE PRONTO POR MÁS BRUTALIDAD!</p>
                </div>
            </div>

            <div id="no-order" class="font-vt py-10 text-center text-2xl">
                Cargando ticket...
            </div>

            <div class="absolute right-0 -bottom-3 left-0 flex h-3 justify-around overflow-hidden">
                {
                    Array.from({ length: 20 }).map((_, i) => (
                        <div key={i} class="bg-brand-yellow border-brand-black h-4 w-4 translate-y-2 rotate-45 border-2" />
                    ))
                }
            </div>
        </div>

        <div class="mt-16">
            <a
                href="/menu"
                class="font-bebas bg-brand-red border-brand-black flex items-center gap-4 border-4 px-12 py-4 text-3xl tracking-widest text-white shadow-[8px_8px_0_#000] transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
            >
                <ArrowLeft /> VOLVER AL MENÚ
            </a>
        </div>
    </main>
</Layout>

<script>
    const lastOrderStr = sessionStorage.getItem("last_order");
    if (lastOrderStr) {
        const order = JSON.parse(lastOrderStr);
        document.getElementById("receipt-content")?.classList.remove("hidden");
        document.getElementById("no-order")?.classList.add("hidden");

        const orderIdEl = document.getElementById("order-id");
        if (orderIdEl) orderIdEl.textContent = order.id.substring(order.id.length - 6).toUpperCase();
        
        const orderDateEl = document.getElementById("order-date");
        if (orderDateEl) orderDateEl.textContent = new Date(order.date).toLocaleDateString();

        const customerNameEl = document.getElementById("customer-name");
        if (customerNameEl) customerNameEl.textContent = order.customer_name;

        const productListEl = document.getElementById("product-list");
        if (productListEl && order.items) {
            order.items.forEach((item: any) => {
                const li = document.createElement("li");
                li.className = "flex justify-between";
                li.innerHTML = `
                    <span>${item.quantity}x ${item.name}</span>
                    <span>$${item.price * item.quantity}</span>
                `;
                productListEl.appendChild(li);
            });
        }

        const orderTotalEl = document.getElementById("order-total");
        if (orderTotalEl) orderTotalEl.textContent = `$${order.total_price}`;
    } else {
        const noOrderEl = document.getElementById("no-order");
        if (noOrderEl) noOrderEl.textContent = "No se encontró información del pedido.";
    }
</script>

<style>
    @keyframes bounce {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
</style>
