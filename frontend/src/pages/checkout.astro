---
import Layout from "@/layouts/Layout.astro";
import { Check, ArrowLeft, Ticket } from "lucide-react";
---

<Layout title="Two Guys Burger - ¡Pedido Realizado!">
    <main class="bg-brand-yellow flex min-h-screen flex-col items-center px-4 pt-32 pb-20">
        <div
            class="border-brand-black mb-8 animate-bounce rounded-full border-4 bg-green-500 p-4 shadow-[6px_6px_0_#000]"
        >
            <Check size={80} strokeWidth={4} className="text-white" />
        </div>

        <h1
            class="font-bebas text-brand-black mb-12 text-center text-6xl md:text-8xl"
            style="text-shadow: 4px 4px 0 #E8192C"
        >
            ¡PEDIDO EN CAMINO!
        </h1>

        <div class="border-brand-black relative w-full max-w-md border-4 bg-white p-8 shadow-[12px_12px_0_#000]">
            <div class="absolute -top-3 right-0 left-0 flex h-3 justify-around overflow-hidden">
                {
                    Array.from({ length: 20 }).map(() => (
                        <div class="bg-brand-yellow border-brand-black h-4 w-4 -translate-y-2 rotate-45 border-2" />
                    ))
                }
            </div>

            <div class="mb-8 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <Ticket className="text-brand-black" />
                    <span class="font-bebas text-2xl">TICKET #{Math.floor(Math.random() * 10000) + 1}</span>
                </div>
                <span class="font-vt text-lg">{new Date().toLocaleDateString()}</span>
            </div>

            <div class="border-brand-black my-6 space-y-4 border-y-2 border-dashed py-6">
                <div class="font-vt flex justify-between text-xl">
                    <span>ESTADO:</span>
                    <span class="font-bold text-green-600">CONFIRMADO</span>
                </div>
                <div class="font-vt flex justify-between text-xl">
                    <span>PAGO:</span>
                    <span>EFECTIVO</span>
                </div>
                <div class="font-vt flex flex-col justify-between text-xl">
                    <span>PRODUCTOS:</span>
                    <ul class="">
                        <li>1</li>
                        <li>2</li>
                        <li>3</li>
                    </ul>
                </div>
                <div class="font-vt flex justify-between text-xl">
                    <span>TOTAL:</span>
                    <span>$300.00</span>
                </div>
            </div>

            <div class="font-vt mt-8 text-center text-lg opacity-60">
                <p>GRACIAS POR TU COMPRA</p>
                <p>¡VUELVE PRONTO POR MÁS BRUTALIDAD!</p>
            </div>

            <div class="absolute right-0 -bottom-3 left-0 flex h-3 justify-around overflow-hidden">
                {
                    Array.from({ length: 20 }).map(() => (
                        <div class="bg-brand-yellow border-brand-black h-4 w-4 translate-y-2 rotate-45 border-2" />
                    ))
                }
            </div>
        </div>

        <div class="mt-16">
            <a
                href="/menu"
                class="font-bebas bg-brand-red border-brand-black flex items-center gap-4 border-4 px-12 py-4 text-3xl tracking-widest text-white shadow-[8px_8px_0_#000] transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-none"
            >
                <ArrowLeft /> VOLVER AL MENÚ
            </a>
        </div>
    </main>
</Layout>

<style>
    @keyframes bounce {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
</style>
